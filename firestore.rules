rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {

      allow read: if request.auth != null &&
        (
          request.auth.uid == uid ||
          get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.rol == "administrador"
        );

      // El doc se crea únicamente desde la Cloud Function onUserCreate
      // (Sprint 1-01 [01], Admin SDK) — el cliente ya no tiene allow create,
      // así nadie puede autoasignarse rol/xp/nivel desde el registro público.

      allow update: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "nombre",
            "institucion",
            "fotoUrl"
          ]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}