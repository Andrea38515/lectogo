rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // El rol vive en usuarios/{uid}.rol (lo crea onUserCreate), no en custom
    // claims: por eso se consulta el documento y no request.auth.token.role.
    function haySesion() {
      return request.auth != null;
    }

    function rolActual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data.rol;
    }

    function esAdmin() {
      return haySesion() && rolActual() == "administrador";
    }

    function esDocente() {
      return haySesion() && rolActual() == "docente";
    }

    match /usuarios/{uid} {

      allow read: if request.auth != null &&
        (
          request.auth.uid == uid ||
          get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.rol == "administrador"
        );

      // El doc se crea únicamente desde la Cloud Function onUserCreate
      // (Sprint 1-01 [01], Admin SDK) — el cliente ya no tiene allow create,
      // así nadie puede autoasignarse rol/xp/nivel desde el registro público.

      allow update: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "nombre",
            "institucion",
            "fotoUrl"
          ]);
    }

    // Las reglas no filtran: una consulta que pueda devolver borradores se
    // rechaza entera. Por eso getLecturas() filtra estado == "publicada".
    match /lecturas/{lecturaId} {
      allow read: if resource.data.estado == "publicada" ||
        esAdmin() ||
        (esDocente() && resource.data.autorId == request.auth.uid);

      allow create: if esAdmin() ||
        (esDocente() && request.resource.data.autorId == request.auth.uid);

      allow update, delete: if esAdmin() ||
        (
          esDocente() &&
          resource.data.autorId == request.auth.uid &&
          request.resource.data.autorId == resource.data.autorId
        );
    }

    match /categorias/{categoriaId} {
      // Solo nombre y descripción: no hay nada sensible. Se abre a invitados
      // para que la biblioteca pública muestre el nombre de cada categoría en
      // vez de "General". (Antes dependía de un campo `publica` que ninguna
      // categoría tiene.)
      allow read: if true;

      // Solo se modifican desde la Cloud Function gestionarCategoria (Admin
      // SDK): así cada cambio queda auditado con su autor. El cliente no
      // escribe, ni siquiera un administrador.
      allow write: if false;
    }

    // Aquí solo vive lo que el estudiante puede ver (enunciado, opciones).
    // respuestaCorrecta y explicacion van en preguntas/{id}/solucion/{doc},
    // que ningún estudiante puede leer; las califica registrarIntento.
    match /preguntas/{preguntaId} {
      allow read: if haySesion();

      allow create: if esAdmin() ||
        (esDocente() && request.resource.data.autorId == request.auth.uid);

      allow update, delete: if esAdmin() ||
        (esDocente() && resource.data.autorId == request.auth.uid);

      match /solucion/{solucionId} {
        allow read, update, delete: if esAdmin() ||
          (
            esDocente() &&
            get(
              /databases/$(database)/documents/preguntas/$(preguntaId)
            ).data.autorId == request.auth.uid
          );

        // get() ve el estado ANTERIOR al lote: crear la pregunta y su solución
        // en un mismo writeBatch fallaría porque la pregunta aún no existe.
        // getAfter() ve el estado posterior, así que sirve para crear ambas a
        // la vez y sigue exigiendo que la pregunta sea del docente. Para
        // borrar se mantiene get(): la pregunta todavía existe antes del lote.
        allow create: if esAdmin() ||
          (
            esDocente() &&
            getAfter(
              /databases/$(database)/documents/preguntas/$(preguntaId)
            ).data.autorId == request.auth.uid
          );
      }
    }

    match /actividades/{actividadId} {
      allow read: if esAdmin() ||
        (esDocente() && resource.data.docenteId == request.auth.uid) ||
        (haySesion() && request.auth.uid in resource.data.estudiantesAsignados);

      // La única vía para crear una actividad es la Cloud Function
      // asignarActividad (Admin SDK): así siempre quedan la auditoría y la
      // garantía de que solo se asigna a estudiantes. Por eso el docente ya
      // no crea desde el cliente, solo puede cambiar el estado de la suya, y
      // borrar queda para el administrador (no dejar huérfana la
      // subcolección asignados, que guarda nombres y correos).
      allow create: if esAdmin();

      allow update: if esAdmin() ||
        (
          esDocente() &&
          resource.data.docenteId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["estado"])
        );

      allow delete: if esAdmin();

      // Nombre y correo de cada estudiante asignado, para la pantalla de
      // progreso. Solo los escribe asignarActividad (Admin SDK) y solo los
      // lee el docente dueño de la actividad (o un administrador): los
      // estudiantes no ven a sus compañeros.
      match /asignados/{estudianteId} {
        allow read: if esAdmin() ||
          (
            esDocente() &&
            get(
              /databases/$(database)/documents/actividades/$(actividadId)
            ).data.docenteId == request.auth.uid
          );

        allow write: if false;
      }
    }

    // Solo los escribe la Cloud Function registrarIntento (Admin SDK).
    match /intentos/{intentoId} {
      allow read: if haySesion() &&
        (
          resource.data.estudianteId == request.auth.uid ||
          esAdmin() ||
          (
            esDocente() &&
            get(
              /databases/$(database)/documents/actividades/$(resource.data.actividadId)
            ).data.docenteId == request.auth.uid
          )
        );

      allow write: if false;
    }

    // Gamificación: la escriben las Cloud Functions; el cliente solo lee.
    // El ranking guarda únicamente el alias, nunca el nombre.
    match /ranking/{rankingId} {
      allow read: if haySesion();
      allow write: if false;
    }

    match /logros/{logroId} {
      allow read: if haySesion();
      allow write: if esAdmin();
    }

    match /logros_usuario/{logroUsuarioId} {
      allow read: if haySesion() &&
        (resource.data.estudianteId == request.auth.uid || esAdmin());

      allow write: if false;
    }

    match /niveles_config/{nivelId} {
      allow read: if haySesion();
      allow write: if esAdmin();
    }

    match /config_negocio/{configId} {
      allow read, write: if esAdmin();
    }

    // Bitácora de acciones sensibles: la escriben las Cloud Functions
    // (Admin SDK) y solo la lee un administrador.
    match /auditoria/{auditoriaId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}